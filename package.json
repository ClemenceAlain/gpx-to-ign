{
  "name": "gpx-to-ign",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --build --force && tsc --noEmit -p packages/core/tsconfig.test.json && tsc --noEmit -p packages/cli/tsconfig.test.json && tsc --noEmit -p packages/web/tsconfig.json",
    "dev": "npm run dev --workspace @gpx-to-ign/web",
    "test:web": "npm run -w @gpx-to-ign/web test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc --build"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.7",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  }
}
